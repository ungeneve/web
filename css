:root {
    --primary-blue: #1a4a7c;
    --accent-red: #b32d2e;
    --light-grey: #f4f4f4;
    --dark-grey: #333;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Roboto', sans-serif;
    line-height: 1.6;
    color: var(--dark-grey);
}

header {
    background: #fff;
    padding: 1rem 5%;
    box-shadow: 0 2px 5px rgba(0,0,0,0.1);
    position: sticky;
    top: 0;
    z-index: 1000;
}

nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.logo-container {
    display: flex;
    align-items: center;
    gap: 10px;
}

.placeholder-logo {
    width: 40px;
    height: 40px;
    background: var(--primary-blue);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    font-weight: bold;
}

.brand-name {
    font-weight: 700;
    color: var(--primary-blue);
    font-size: 1.2rem;
}

nav ul {
    display: flex;
    list-style: none;
    gap: 20px;
}

nav a {
    text-decoration: none;
    color: var(--dark-grey);
    font-weight: 500;
    transition: color 0.3s;
}

nav a:hover {
    color: var(--accent-red);
}

#hero {
    height: 60vh;
    background: linear-gradient(rgba(26, 74, 124, 0.8), rgba(26, 74, 124, 0.8)), url('https://images.unsplash.com/photo-1469571486292-0ba58a3f068b?auto=format&fit=crop&q=80&w=1000') center/cover;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: white;
}

.hero-content h1 {
    font-size: 3rem;
    margin-bottom: 1rem;
}

#cta-btn {
    padding: 12px 30px;
    background: var(--accent-red);
    color: white;
    border: none;
    border-radius: 5px;
    cursor: pointer;
    font-size: 1rem;
    margin-top: 1.5rem;
    transition: background 0.3s;
}

#cta-btn:hover {
    background: #8e2324;
}

#about {
    padding: 4rem 5%;
    text-align: center;
}

.card-container {
    display: flex;
    gap: 20px;
    margin-top: 3rem;
    flex-wrap: wrap;
}

.card {
    flex: 1;
    min-width: 250px;
    padding: 2rem;
    background: var(--light-grey);
    border-top: 5px solid var(--primary-blue);
    border-radius: 5px;
}

footer {
    background: var(--dark-grey);
    color: white;
    text-align: center;
    padding: 2rem;
    margin-top: 4rem;
}
